# Upstream source fetched when building the image.
BC_CODE_ATLAS_REPOSITORY=https://github.com/StefanMaron/bc-code-atlas.git
BC_CODE_ATLAS_REF=master

# Host port that publishes the unified MCP endpoint.
BCATLAS_PORT=8800

# Grace period for the initial health check while corpus indexes are built.
# Docker Compose duration syntax is accepted, for example: 30m, 2h, or 4h.
BCATLAS_HEALTH_START_PERIOD=4h

# Set to the public hostname when running behind a reverse proxy or tunnel.
# Example: bc-code-atlas.example.com
AGGREGATOR_PUBLIC_HOSTNAME=

# Local sentence-transformers embedding configuration used during bootstrap.
BCATLAS_EMBEDDING_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
BCATLAS_EMBEDDING_DEVICE=cpu

# On-demand build behavior.
BCATLAS_BUILD_MAX_CONCURRENT=1
BCATLAS_BUILD_MIN_OVERLAP_RATIO=0.5
BCATLAS_CCC_STALL_TIMEOUT_S=300
BCATLAS_CCC_INDEX_MAX_TOTAL_S=14400

# Maximum disk usage for warm, on-demand version data (bytes; default 50 GiB).
BCATLAS_WARM_DISK_BUDGET_BYTES=53687091200

# Optional search reindex interval in seconds. Empty disables watch mode.
BCATLAS_WATCH_INTERVAL_SECONDS=

# Maximum graph JSON size accepted by graphify-al.
GRAPHIFY_MAX_GRAPH_BYTES=1GB

# Optional custom MCP instructions for the graph server. Empty uses upstream's
# Business Central instructions. For multiline text, use a Compose override.
GRAPHIFY_INSTRUCTIONS=
